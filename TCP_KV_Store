def run_acid_tests():
    """
    Test ACID properties of the database.
    - Atomicity: Bulk operations are all-or-nothing
    - Consistency: Concurrent operations don't corrupt data
    - Isolation: Concurrent bulk sets on same keys don't interfere
    - Durability: Data survives crashes
    """
    import shutil
    
    data_dir = './acid_test_kvstore_data'
    if os.path.exists(data_dir):
        shutil.rmtree(data_dir)
    
    # Start server in debug mode for atomicity testing
    server = KVServer(port=5558, data_dir=data_dir, debug_mode=True)
    server_thread = threading.Thread(target=server.start, daemon=True)
    server_thread.start()
    time.sleep(1)
    
    try:
        print("\n" + "="*60)
        print("ACID COMPLIANCE TESTS")
        print("="*60)
        
        # Test 1: Isolation - Concurrent bulk sets on same keys
        print("\nTest 1: Isolation - Concurrent BulkSet on same keys")
        print("  Testing that concurrent writes don't corrupt each other...")
        
        results = defaultdict(list)
        lock = threading.Lock()
        
        def bulk_writer(client_id, num_ops=100):
            """
            Write bulk operations concurrently.
            Each client writes its own value to shared keys.
            """
            client = KVClient(port=5558)
            for i in range(num_ops):
                items = [(f'shared_key_{j}', f'client_{client_id}_value_{i}') 
                         for j in range(10)]
                client.BulkSet(items)
                time.sleep(0.001)  # Small delay
            client.close()
        
        # Run 5 concurrent writers
        threads = []
        for i in range(5):
            t = threading.Thread(target=bulk_writer, args=(i,))
            threads.append(t)
            t.start()
        
        for t in threads:
            t.join()
        
        # Verify data consistency - each key should have valid value from one client
        client = KVClient(port=5558)
        corrupted = 0
        for j in range(10):
            value = client.Get(f'shared_key_{j}')
            if value is None or not value.startswith('client_'):
                corrupted += 1
        
        print(f"  Checked 10 keys, found {corrupted} corrupted values")
        assert corrupted == 0, "Data corruption detected!"
        print("✓ Passed - No data corruption from concurrent writes")
        
        # Test 2: Atomicity - Bulk operations are all-or-nothing
        print("\nTest 2: Atomicity - BulkSet with server kills")
        print("  Testing that bulk operations are atomic (all-or-nothing)...")
        
        # Start a new server process that we can kill
        server.stop()
        time.sleep(1)
        
        # Launch server as subprocess so we can kill it
        server_script = f"""
import sys
sys.path.insert(0, '{os.getcwd()}')
from {Path(__file__).stem} import KVServer
import time

server = KVServer(port=5558, data_dir='{data_dir}', debug_mode=False)
try:
    server.start()
except KeyboardInterrupt:
    server.stop()
"""
        
        # Write server script to temp file
        temp_script = Path(data_dir) / 'temp_server.py'
        temp_script.write_text(server_script)
        
        # Start server process
        import platform
        if platform.system() == 'Windows':
            process = subprocess.Popen([sys.executable, str(temp_script)], 
                                      creationflags=subprocess.CREATE_NEW_PROCESS_GROUP)
        else:
            process = subprocess.Popen([sys.executable, str(temp_script)])
        
        time.sleep(2)  # Wait for server to start
        
        # Track which bulk operations we attempted
        attempted_bulks = []
        completed_bulks = []
        
        def bulk_writer_with_tracking():
            """Write bulk operations and track completion."""
            client = KVClient(port=5558)
            for i in range(20):
                items = [(f'atomic_key_{i}_{j}', f'value_{i}_{j}') 
                         for j in range(10)]
                attempted_bulks.append(i)
                try:
                    client.BulkSet(items)
                    completed_bulks.append(i)
                except:
                    pass
                time.sleep(0.05)
            client.close()
        
        def random_killer():
            """Kill server randomly during bulk operations."""
            time.sleep(0.3)  # Let some operations complete
            for _ in range(3):
                time.sleep(0.2)
                print(f"    Killing server (PID: {process.pid})...")
                # Force kill with SIGKILL equivalent
                if platform.system() == 'Windows':
                    subprocess.run(['taskkill', '/F', '/T', '/PID', str(process.pid)], 
                                 capture_output=True)
                else:
                    process.kill()  # Sends SIGKILL
                
                time.sleep(0.5)
                
                # Restart server
                print("    Restarting server...")
                if platform.system() == 'Windows':
                    new_process = subprocess.Popen([sys.executable, str(temp_script)],
                                                  creationflags=subprocess.CREATE_NEW_PROCESS_GROUP)
                else:
                    new_process = subprocess.Popen([sys.executable, str(temp_script)])
                process.__dict__.update(new_process.__dict__)
                time.sleep(1.5)
        
        writer_thread = threading.Thread(target=bulk_writer_with_tracking)
        killer_thread = threading.Thread(target=random_killer)
        
        writer_thread.start()
        killer_thread.start()
        
        writer_thread.join()
        killer_thread.join()
        time.sleep(1)
        
        # Verify atomicity - each bulk operation should be complete or not exist
        client = KVClient(port=5558)
        partial_bulks = 0
        
        for i in attempted_bulks:
            keys_found = 0
            for j in range(10):
                if client.Get(f'atomic_key_{i}_{j}') is not None:
                    keys_found += 1
            
            # Either all 10 keys exist or none (atomicity)
            if keys_found > 0 and keys_found < 10:
                partial_bulks += 1
                print(f"    Bulk {i}: Found {keys_found}/10 keys (PARTIAL!)")
        
        print(f"  Attempted {len(attempted_bulks)} bulk operations")
        print(f"  Found {partial_bulks} partial bulk operations")
        assert partial_bulks == 0, "Atomicity violated - found partial bulk operations!"
        print("✓ Passed - All bulk operations are atomic")
        
        client.close()
        
        # Cleanup subprocess
        if process.poll() is None:
            if platform.system() == 'Windows':
                subprocess.run(['taskkill', '/F', '/T', '/PID', str(process.pid)], 
                             capture_output=True)
            else:
                process.kill()
        
        print("\n✓ All ACID tests passed!")
        
    finally:
        if 'process' in locals() and process.poll() is None:
            if platform.system() == 'Windows':
                subprocess.run(['taskkill', '/F', '/T', '/PID', str(process.pid)], 
                             capture_output=True)
            else:
                process.kill()
        time.sleep(1)


def run_benchmarks():
    """
    Run performance benchmarks.
    - Write throughput with varying data sizes
    - Durability testing with random server kills
    """
    import shutil
    import platform
    
    data_dir = './bench_kvstore_data'
    if os.path.exists(data_dir):
        shutil.rmtree(data_dir)
    
    server = KVServer(port=5557, data_dir=data_dir)
    server_thread = threading.Thread(target=server.start, daemon=True)
    server_thread.start()
    time.sleep(1)
    
    try:
        print("\n" + "="*60)
        print("PERFORMANCE BENCHMARKS")
        print("="*60)
        
        client = KVClient(port=5557)
        
        # Benchmark 1: Write throughput with varying data sizes
        print("\nBenchmark 1: Write Throughput")
        print("  Testing how data size affects write performance...")
        
        for data_size in [0, 1000, 10000, 50000]:
            # Pre-populate database
            if data_size > 0:
                print(f"  Pre-populating with {data_size} keys...")
                items = [(f'prepop_{i}', f'value_{i}') for i in range(data_size)]
                for i in range(0, len(items), 1000):
                    client.BulkSet(items[i:i+1000])
            
            # Measure write throughput
            num_writes = 5000
            start_time = time.time()
            
            for i in range(num_writes):
                client.Set(f'bench_key_{i}', f'bench_value_{i}')
            
            elapsed = time.time() - start_time
            throughput = num_writes / elapsed
            latency_ms = elapsed * 1000 / num_writes
            
            print(f"  Data size: {data_size:6d} keys | "
                  f"Throughput: {throughput:8.2f} writes/sec | "
                  f"Latency: {latency_ms:.3f} ms/write")
        
        # Benchmark 2: Durability test with SIGKILL
        print("\nBenchmark 2: Durability Test (with SIGKILL)")
        print("  Testing write acknowledgment vs actual persistence...")
        print("  Using process.kill() to simulate hard crashes...")
        
        client.close()
        server.stop()
        time.sleep(1)
        
        # Start server as subprocess for killing
        server_script = f"""
import sys
sys.path.insert(0, '{os.getcwd()}')
from {Path(__file__).stem} import KVServer

server = KVServer(port=5557, data_dir='{data_dir}')
try:
    server.start()
except KeyboardInterrupt:
    server.stop()
"""
        
        temp_script = Path(data_dir) / 'temp_bench_server.py'
        temp_script.write_text(server_script)
        
        if platform.system() == 'Windows':
            process = subprocess.Popen([sys.executable, str(temp_script)],
                                      creationflags=subprocess.CREATE_NEW_PROCESS_GROUP)
        else:
            process = subprocess.Popen([sys.executable, str(temp_script)])
        
        time.sleep(2)
        
        acknowledged_keys = set()
        lock = threading.Lock()
        stop_flag = threading.Event()
        
        def writer():
            """Write data continuously and track acknowledged writes."""
            client_w = None
            i = 0
            while not stop_flag.is_set():
                try:
                    if client_w is None:
                        client_w = KVClient(port=5557)
                    
                    key = f'durable_{i}'
                    client_w.Set(key, f'value_{i}')
                    with lock:
                        acknowledged_keys.add(key)
                    i += 1
                    time.sleep(0.002)  # Moderate write rate
                except Exception as e:
                    # Reconnect on error
                    client_w = None
                    time.sleep(0.5)
        
        def killer():
            """Kill and restart server using SIGKILL."""
            nonlocal process
            time.sleep(2)  # Let some data accumulate
            
            for kill_num in range(3):
                time.sleep(1.5)
                print(f"    Kill #{kill_num + 1}: Sending SIGKILL to PID {process.pid}...")
                
                # Force kill with SIGKILL (-9 equivalent)
                if platform.system() == 'Windows':
                    subprocess.run(['taskkill', '/F', '/T', '/PID', str(process.pid)],
                                 capture_output=True)
                else:
                    process.kill()  # Sends SIGKILL (-9)
                
                time.sleep(0.5)
                
                # Restart server
                print(f"    Restarting server...")
                if platform.system() == 'Windows':
                    process = subprocess.Popen([sys.executable, str(temp_script)],
                                              creationflags=subprocess.CREATE_NEW_PROCESS_GROUP)
                else:
                    process = subprocess.Popen([sys.executable, str(temp_script)])
                
                time.sleep(1.5)
        
        writer_thread = threading.Thread(target=writer, daemon=True)
        killer_thread = threading.Thread(target=killer, daemon=True)
        
        writer_thread.start()
        killer_thread.start()
        
        killer_thread.join()
        stop_flag.set()
        writer_thread.join()
        time.sleep(2)
        
        # Check for lost keys
        print("  Verifying data persistence...")
        client_check = KVClient(port=5557)
        lost_keys = set()
        
        with lock:
            total_acked = len(acknowledged_keys)
            for key in acknowledged_keys:
                if client_check.Get(key) is None:
                    lost_keys.add(key)
        
        durability = (1 - len(lost_keys) / total_acked) * 100 if total_acked else 100
        
        print(f"  Total acknowledged writes: {total_acked}")
        print(f"  Lost writes: {len(lost_keys)}")
        print(f"  Durability: {durability:.2f}%")
        
        if len(lost_keys) > 0:
            print(f"  ⚠ WARNING: {len(lost_keys)} acknowledged writes were lost!")
        else:
            print(f"  ✓ Perfect durability - no acknowledged writes lost!")
        
        client_check.close()
        
        # Cleanup
        if process.poll() is None:
            if platform.system() == 'Windows':
                subprocess.run(['taskkill', '/F', '/T', '/PID', str(process.pid)],
                             capture_output=True)
            else:
                process.kill()
        
    finally:
        if 'process' in locals() and process.poll() is None:
            if platform.system() == 'Windows':
                subprocess.run(['taskkill', '/F', '/T', '/PID', str(process.pid)],
                             capture_output=True)
            else:
                process.kill()
        time.sleep(1)


