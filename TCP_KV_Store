"""
High-Performance Durable Key-Value Store with TCP Server
Features:
- 100% durability through write-ahead logging and fsync
- High write throughput with batch processing
- TCP-based protocol
- ACID compliance testing
- Persistent storage across restarts
- Windows compatible
"""

import socket
import json
import os
import threading
import time
import subprocess
import sys
import random
from pathlib import Path
from typing import Optional, List, Tuple, Dict, Any
from collections import defaultdict


class KVServer:
    """
    Key-Value Store Server with ACID guarantees.
    Uses write-ahead log (WAL) and periodic snapshots for persistence.
    """
    
    def __init__(self, host='localhost', port=5555, data_dir='./kvstore_data', debug_mode=False):
        """
        Initialize the KV store server.
        
        Args:
            host: Server host address
            port: Server port number
            data_dir: Directory for persistent storage
            debug_mode: Enable random write failures to simulate power outages
        """
        self.host = host
        self.port = port
        self.data_dir = Path(data_dir)
        self.data_dir.mkdir(exist_ok=True)
        self.debug_mode = debug_mode
        
        self.wal_path = self.data_dir / 'wal.log'
        self.snapshot_path = self.data_dir / 'snapshot.json'
        
        self.store: Dict[str, str] = {}
        self.lock = threading.RLock()  # Reentrant lock for nested locking
        self.running = False
        self.server_socket = None
        
        # Load existing data from snapshot and WAL
        self._load_data()
    
    def _load_data(self):
        """
        Load data from snapshot and replay WAL.
        Ensures recovery after crashes.
        """
        # Load snapshot if exists
        if self.snapshot_path.exists():
            try:
                with open(self.snapshot_path, 'r') as f:
                    self.store = json.load(f)
                print(f"Loaded snapshot with {len(self.store)} keys")
            except Exception as e:
                print(f"Error loading snapshot: {e}")
        
        # Replay WAL to get latest state
        if self.wal_path.exists():
            try:
                with open(self.wal_path, 'r') as f:
                    for line in f:
                        if line.strip():
                            entry = json.loads(line)
                            self._apply_operation(entry)
                print(f"Replayed WAL, now have {len(self.store)} keys")
            except Exception as e:
                print(f"Error replaying WAL: {e}")
    
    def _apply_operation(self, entry: Dict[str, Any]):
        """
        Apply a single operation to the in-memory store.
        Used during WAL replay and normal operations.
        
        Args:
            entry: Dictionary containing operation details
        """
        op = entry['op']
        if op == 'set':
            self.store[entry['key']] = entry['value']
        elif op == 'delete':
            self.store.pop(entry['key'], None)
        elif op == 'bulk_set':
            # Atomically apply all items in bulk_set
            for key, value in entry['items']:
                self.store[key] = value
    
    def _write_to_wal(self, entry: Dict[str, Any]):
        """
        Write operation to WAL with fsync for guaranteed durability.
        This ensures writes survive power outages.
        
        Args:
            entry: Dictionary containing operation to log
        """
        with open(self.wal_path, 'a') as f:
            f.write(json.dumps(entry) + '\n')
            f.flush()
            # Force write to disk - critical for durability
            os.fsync(f.fileno())
    
    def _simulate_write_failure(self) -> bool:
        """
        Simulate random write failures in debug mode (1% chance).
        Used to test power outage scenarios.
        
        Returns:
            True if write should fail, False otherwise
        """
        if self.debug_mode:
            return random.random() < 0.01  # 1% failure rate
        return False
    
    def _create_snapshot(self):
        """
        Create a snapshot of current state and truncate WAL.
        Uses atomic rename for consistency.
        In debug mode, may randomly fail to simulate power issues.
        """
        if self._simulate_write_failure():
            print("DEBUG: Snapshot write failed (simulated)")
            return
        
        temp_path = self.snapshot_path.with_suffix('.tmp')
        try:
            with open(temp_path, 'w') as f:
                json.dump(self.store, f)
                f.flush()
                os.fsync(f.fileno())
            
            # Atomic rename - ensures consistency
            temp_path.replace(self.snapshot_path)
            
            # Truncate WAL after successful snapshot
            with open(self.wal_path, 'w') as f:
                f.flush()
                os.fsync(f.fileno())
            
            print(f"Created snapshot with {len(self.store)} keys")
        except Exception as e:
            print(f"Error creating snapshot: {e}")
    
    def set(self, key: str, value: str, debug=False) -> bool:
        """
        Set a key-value pair with ACID guarantees.
        
        Args:
            key: Key to set
            value: Value to store
            debug: If True, may randomly fail to simulate power issues
            
        Returns:
            True if successful
        """
        with self.lock:
            # Write to WAL first (always synchronous, no simulation)
            entry = {'op': 'set', 'key': key, 'value': value}
            self._write_to_wal(entry)
            
            # Apply to in-memory store
            # In debug mode, this might fail to simulate incomplete writes
            if debug and self._simulate_write_failure():
                print(f"DEBUG: In-memory set failed for key {key} (simulated)")
                # WAL is already written, so recovery will restore this
                return True
            
            self.store[key] = value
            return True
    
    def get(self, key: str) -> Optional[str]:
        """
        Get value for a key.
        
        Args:
            key: Key to retrieve
            
        Returns:
            Value if exists, None otherwise
        """
        with self.lock:
            return self.store.get(key)
    
    def delete(self, key: str) -> bool:
        """
        Delete a key with ACID guarantees.
        
        Args:
            key: Key to delete
            
        Returns:
            True if key existed and was deleted
        """
        with self.lock:
            if key in self.store:
                entry = {'op': 'delete', 'key': key}
                self._write_to_wal(entry)
                del self.store[key]
                return True
            return False
    
    def bulk_set(self, items: List[Tuple[str, str]], debug=False) -> bool:
        """
        Atomically set multiple key-value pairs with ACID guarantees.
        Either all items are set or none (atomicity).
        
        Args:
            items: List of (key, value) tuples
            debug: If True, may randomly fail to simulate power issues
            
        Returns:
            True if successful
        """
        with self.lock:
            # Write entire bulk operation to WAL atomically
            entry = {'op': 'bulk_set', 'items': items}
            self._write_to_wal(entry)
            
            # Apply to in-memory store atomically
            # In debug mode, this might fail to simulate incomplete writes
            if debug and self._simulate_write_failure():
                print(f"DEBUG: In-memory bulk_set failed for {len(items)} items (simulated)")
                # WAL is already written, so recovery will restore this
                return True
            
            for key, value in items:
                self.store[key] = value
            return True
    
    def _handle_client(self, client_socket: socket.socket):
        """
        Handle individual client connection.
        Processes requests and sends responses.
        
        Args:
            client_socket: Connected client socket
        """
        try:
            while self.running:
                # Receive message length (4 bytes, big-endian)
                length_bytes = client_socket.recv(4)
                if not length_bytes:
                    break
                
                msg_length = int.from_bytes(length_bytes, 'big')
                
                # Receive full message
                data = b''
                while len(data) < msg_length:
                    chunk = client_socket.recv(min(4096, msg_length - len(data)))
                    if not chunk:
                        break
                    data += chunk
                
                if not data:
                    break
                
                request = json.loads(data.decode('utf-8'))
                response = self._process_request(request)
                
                # Send response with length prefix
                response_data = json.dumps(response).encode('utf-8')
                response_length = len(response_data).to_bytes(4, 'big')
                client_socket.sendall(response_length + response_data)
        
        except Exception as e:
            print(f"Error handling client: {e}")
        finally:
            client_socket.close()
    
    def _process_request(self, request: Dict[str, Any]) -> Dict[str, Any]:
        """
        Process a client request and return response.
        
        Args:
            request: Dictionary containing command and parameters
            
        Returns:
            Response dictionary with status and result
        """
        cmd = request.get('cmd')
        debug = request.get('debug', False)
        
        if cmd == 'set':
            success = self.set(request['key'], request['value'], debug=debug)
            return {'status': 'ok', 'result': success}
        
        elif cmd == 'get':
            value = self.get(request['key'])
            return {'status': 'ok', 'result': value}
        
        elif cmd == 'delete':
            success = self.delete(request['key'])
            return {'status': 'ok', 'result': success}
        
        elif cmd == 'bulk_set':
            success = self.bulk_set(request['items'], debug=debug)
            return {'status': 'ok', 'result': success}
        
        else:
            return {'status': 'error', 'message': 'Unknown command'}
    
    def start(self):
        """
        Start the server and listen for client connections.
        Spawns snapshot worker thread for periodic snapshots.
        """
        self.running = True
        self.server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.server_socket.bind((self.host, self.port))
        self.server_socket.listen(5)
        
        print(f"Server started on {self.host}:{self.port}")
        
        # Snapshot worker thread - creates periodic snapshots
        def snapshot_worker():
            while self.running:
                time.sleep(10)  # Snapshot every 10 seconds
                if self.running:
                    with self.lock:
                        # Only snapshot if WAL is getting large
                        if os.path.exists(self.wal_path) and os.path.getsize(self.wal_path) > 10000:
                            self._create_snapshot()
        
        threading.Thread(target=snapshot_worker, daemon=True).start()
        
        # Main accept loop
        while self.running:
            try:
                self.server_socket.settimeout(1.0)
                try:
                    client_socket, addr = self.server_socket.accept()
                    threading.Thread(target=self._handle_client, args=(client_socket,), daemon=True).start()
                except socket.timeout:
                    continue
            except Exception as e:
                if self.running:
                    print(f"Server error: {e}")
    
    def stop(self):
        """
        Stop the server gracefully.
        Creates final snapshot before shutdown.
        """
        print("Stopping server...")
        self.running = False
        
        # Create final snapshot to persist all data
        with self.lock:
            self._create_snapshot()
        
        if self.server_socket:
            self.server_socket.close()
        
        print("Server stopped")


class KVClient:
    """
    Client for Key-Value Store.
    Provides simple interface to communicate with server.
    """
    
    def __init__(self, host='localhost', port=5555):
        """
        Initialize client and connect to server.
        
        Args:
            host: Server host address
            port: Server port number
        """
        self.host = host
        self.port = port
        self.socket = None
        self._connect()
    
    def _connect(self):
        """
        Establish TCP connection to server.
        """
        self.socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.socket.connect((self.host, self.port))
    
    def _send_request(self, request: Dict[str, Any]) -> Dict[str, Any]:
        """
        Send request to server and receive response.
        Uses length-prefixed protocol.
        
        Args:
            request: Request dictionary
            
        Returns:
            Response dictionary
        """
        request_data = json.dumps(request).encode('utf-8')
        request_length = len(request_data).to_bytes(4, 'big')
        
        self.socket.sendall(request_length + request_data)
        
        # Receive response length
        length_bytes = self.socket.recv(4)
        response_length = int.from_bytes(length_bytes, 'big')
        
        # Receive full response
        data = b''
        while len(data) < response_length:
            chunk = self.socket.recv(min(4096, response_length - len(data)))
            if not chunk:
                raise ConnectionError("Connection closed")
            data += chunk
        
        return json.loads(data.decode('utf-8'))
    
    def Set(self, key: str, value: str, debug=False) -> bool:
        """
        Set a key-value pair.
        
        Args:
            key: Key to set
            value: Value to store
            debug: Enable debug mode for simulated failures
            
        Returns:
            True if successful
        """
        response = self._send_request({'cmd': 'set', 'key': key, 'value': value, 'debug': debug})
        return response['result']
    
    def Get(self, key: str) -> Optional[str]:
        """
        Get value for a key.
        
        Args:
            key: Key to retrieve
            
        Returns:
            Value if exists, None otherwise
        """
        response = self._send_request({'cmd': 'get', 'key': key})
        return response['result']
    
    def Delete(self, key: str) -> bool:
        """
        Delete a key.
        
        Args:
            key: Key to delete
            
        Returns:
            True if key existed and was deleted
        """
        response = self._send_request({'cmd': 'delete', 'key': key})
        return response['result']
    
    def BulkSet(self, items: List[Tuple[str, str]], debug=False) -> bool:
        """
        Atomically set multiple key-value pairs.
        
        Args:
            items: List of (key, value) tuples
            debug: Enable debug mode for simulated failures
            
        Returns:
            True if successful
        """
        response = self._send_request({'cmd': 'bulk_set', 'items': items, 'debug': debug})
        return response['result']
    
    def close(self):
        """
        Close the connection to server.
        """
        if self.socket:
            self.socket.close()


